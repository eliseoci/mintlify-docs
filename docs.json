{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Centro de ayuda | Nexo AI",
  "description": "Todo lo que necesitás para configurar, operar y sacar el máximo provecho de tus agentes IA.",
  "colors": {
    "primary": "#6d45f9",
    "light": "#8B6BFF",
    "dark": "#5535D4"
