  "logo": {
    "light": "/logo/nexo-logo.png",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Ir al app",
      "href": "https://app.nexoai.group"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nexoai",
      "linkedin": "https://linkedin.com/company/nexoai"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.nexoai.group"
    }
  }
