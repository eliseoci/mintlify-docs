      "anchors": [
        {
          "anchor": "Inicio",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Ir al app",
          "icon": "arrow-up-right",
          "href": "https://app.nexoai.group"
        }
      ]
    },
    "groups": [
      {
        "group": "Primeros pasos",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "primeros-pasos/que-es-nexo",
          "primeros-pasos/inicio-rapido",
          "primeros-pasos/conceptos-clave"
        ]
      },
      {
        "group": "Agentes",
        "icon": "bot",
        "pages": [
          "agentes/crear-agente",
          "agentes/configurar-prompt",
          "agentes/playground",
          "agentes/base-de-conocimiento"
        ]
      },
      {
        "group": "Canales",
        "icon": "radio",
        "pages": [
          "canales/resumen",
          "canales/whatsapp-api",
          "canales/whatsapp-web",
          "canales/instagram",
          "canales/chatwoot"
        ]
      },
      {
        "group": "Campañas",
        "icon": "megaphone",
        "pages": [
          "campanas/crear-campana",
          "campanas/seguimientos"
        ]
      },
      {
        "group": "Contactos",
        "icon": "users",
        "pages": [
          "contactos/gestionar-contactos",
          "contactos/conversaciones"
        ]
      },
      {
        "group": "Clientes y agencias",
        "icon": "building-2",
        "pages": [
          "clientes-agencias/gestionar-clientes",
          "clientes-agencias/agencias",
          "clientes-agencias/roles-permisos"
        ]
      },
      {
        "group": "Analítica",
        "icon": "chart-bar",
        "pages": [
          "analitica/dashboard"
        ]
      },
      {
        "group": "Integraciones",
        "icon": "plug",
        "pages": [
          "integraciones/meta-informacion-negocio",
          "integraciones/whatsapp-business-api"
