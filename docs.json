{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Centro de ayuda | Nexo AI",
  "description": "Guías para configurar Nexo, atender clientes y organizar oportunidades y tareas.",
  "colors": {
    "primary": "#6d45f9",
    "light": "#8B6BFF",
    "dark": "#5535D4"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "assistant"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Inicio",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Ir a Nexo",
          "icon": "arrow-up-right",
          "href": "https://app.nexoai.group"
        }
      ]
    },
    "languages": [
      {
        "language": "es",
        "groups": [
          {
            "group": "Empezar con Nexo",
            "icon": "rocket",
            "pages": [
              "primeros-pasos/que-es-nexo",
              "primeros-pasos/inicio-rapido",
              "primeros-pasos/acceso",
              "primeros-pasos/conceptos-clave"
            ]
          },
          {
            "group": "Organización y equipo",
            "icon": "users",
            "pages": [
              "organizacion/roles-permisos",
              "organizacion/planes-consumo"
            ]
          },
          {
            "group": "Asistente IA",
            "icon": "bot",
            "pages": [
              "agentes/crear-agente",
              "agentes/configurar-prompt",
              "agentes/base-de-conocimiento",
              "agentes/enviar-archivos",
              "agentes/playground"
            ]
          },
          {
            "group": "Canales",
            "icon": "radio",
            "pages": [
              "canales/resumen",
              "canales/whatsapp-api",
              "canales/whatsapp-web",
              "canales/instagram"
            ]
          },
          {
            "group": "Conversaciones y CRM",
            "icon": "messages-square",
            "pages": [
              "contactos/conversaciones",
              "contactos/gestionar-contactos",
              "canales/chatwoot"
            ]
          },
          {
            "group": "Embudo",
            "icon": "columns-3",
            "pages": [
              "embudo/introduccion",
              "embudo/configurar-etapas",
              "embudo/gestionar-oportunidades",
              "embudo/movimiento-ia"
            ]
          },
          {
            "group": "Tareas",
            "icon": "list-checks",
            "pages": [
              "tareas/crear-y-gestionar",
              "tareas/supervisar-equipo"
            ]
          },
          {
            "group": "Campañas y seguimientos",
            "icon": "megaphone",
            "pages": [
              "campanas/plantillas-whatsapp",
              "campanas/crear-campana",
              "campanas/seguimientos"
            ]
          },
          {
            "group": "Actividad y ayuda",
            "icon": "circle-help",
            "pages": [
              "analitica/dashboard",
              "ayuda/problemas-frecuentes"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/nexo-logo.png",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Ir a Nexo",
      "href": "https://app.nexoai.group"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.nexoai.group"
    }
  },
  "redirects": [
    {
      "source": "/clientes-agencias/agencias",
      "destination": "/primeros-pasos/inicio-rapido"
    },
    {
      "source": "/clientes-agencias/gestionar-clientes",
      "destination": "/primeros-pasos/inicio-rapido"
    },
    {
      "source": "/clientes-agencias/roles-permisos",
      "destination": "/organizacion/roles-permisos"
    },
    {
      "source": "/configuracion/ajustes-generales",
      "destination": "/primeros-pasos/inicio-rapido"
    },
    {
      "source": "/configuracion/mi-cuenta",
      "destination": "/primeros-pasos/acceso"
    },
    {
      "source": "/integraciones/whatsapp-business-api",
      "destination": "/canales/whatsapp-api"
    },
    {
      "source": "/integraciones/meta-informacion-negocio",
      "destination": "/canales/whatsapp-api"
    }
  ]
}
